# PORT: Porta local do servidor Express (mesma usada pelo Cloud Run em produção)
PORT="8080"

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- CONFIGURAÇÕES BEERLANDA ---
# E-mail de contato oficial da Beerlanda
CONTACT_EMAIL="beerlandaprodutosartesanais@gmail.com"

# E-mails Google (separados por vírgula) autorizados a usar o Painel Admin
ADMIN_EMAILS="MY_ADMIN_EMAIL@example.com"

# Bucket do Google Cloud Storage onde as fotos dos produtos ficam hospedadas
STORAGE_BUCKET="beerlanda-product-images"

# Credencial da service account usada para subir imagens (só em dev local —
# em produção o Cloud Run já usa sua própria service account automaticamente)
GOOGLE_APPLICATION_CREDENTIALS=".secrets/storage-sa-key.json"

# ID do projeto no Google Cloud (Firestore/Storage)
GOOGLE_CLOUD_PROJECT="beerlanda"

# Só necessário em plataformas SEM metadata server do GCP (ex: Vercel, Render).
# Cole aqui o JSON INTEIRO da mesma service account key (uma linha só) —
# no Cloud Run isso não é usado, pois as credenciais já vêm do ambiente.
FIREBASE_SERVICE_ACCOUNT_KEY=""

# --- MERCADO PAGO (checkout com cartão e Pix) ---
# Public Key: usada no FRONTEND (não é segredo, identifica a conta)
MERCADOPAGO_PUBLIC_KEY="MY_MERCADOPAGO_PUBLIC_KEY"

# Access Token: usada só no BACKEND — nunca expor no frontend nem commitar
MERCADOPAGO_ACCESS_TOKEN="MY_MERCADOPAGO_ACCESS_TOKEN"

# --- CORREIOS (cálculo de frete) ---
# Chave de API dos Correios — usada só no BACKEND, nunca expor no frontend nem commitar
CORREIOS_API_KEY="MY_CORREIOS_API_KEY"

# CEP de origem dos envios (necessário para calcular o frete)
CORREIOS_ORIGIN_CEP="MY_CORREIOS_ORIGIN_CEP"

# CPF/CNPJ do usuário do contrato Correios — junto com CORREIOS_ACCESS_CODE, autentica
# automaticamente em api.correios.com.br pra obter um token Bearer novo a cada chamada.
CORREIOS_USER_ID="MY_CORREIOS_USER_ID"

# Código de acesso do contrato Correios (diferente da senha de login do site).
CORREIOS_ACCESS_CODE="MY_CORREIOS_ACCESS_CODE"
