# PORT: Porta local do servidor Express (mesma usada pelo Cloud Run em produção)
PORT="8080"

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- CONFIGURAÇÕES DO GOOGLE SHEETS & BEERLANDA ---
# ID da planilha do Google Sheets (ex: 1A2B3C4D5E6F7G8H9I0J...)
GOOGLE_SHEET_ID="MY_GOOGLE_SHEET_ID"

# ID da pasta do Google Drive contendo as imagens dos produtos
GOOGLE_DRIVE_FOLDER_ID="MY_GOOGLE_DRIVE_FOLDER_ID"

# Chave de API do Google Cloud para ler os dados da planilha sem autenticação de usuário final
GOOGLE_API_KEY="MY_GOOGLE_API_KEY"

# Número do WhatsApp da Beerlanda para receber os pedidos formatados (ex: 5541998996996)
WHATSAPP_PHONE="5541998996996"

# E-mail de contato oficial da Beerlanda
CONTACT_EMAIL="beerlandaprodutosartesanais@gmail.com"

# E-mails Google (separados por vírgula) autorizados a usar o Painel Admin
# (sincronizar planilha / organizar fotos do Drive)
ADMIN_EMAILS="MY_ADMIN_EMAIL@example.com"
