# PORT: Porta local do servidor Express (mesma usada pelo Cloud Run em produção)
PORT="8080"

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- CONFIGURAÇÕES BEERLANDA ---
# E-mail de contato oficial da Beerlanda
CONTACT_EMAIL="beerlandaprodutosartesanais@gmail.com"

# E-mails Google (separados por vírgula) autorizados a usar o Painel Admin
ADMIN_EMAILS="MY_ADMIN_EMAIL@example.com"

# Bucket do Google Cloud Storage onde as fotos dos produtos ficam hospedadas
STORAGE_BUCKET="beerlanda-product-images"

# Credencial da service account usada para subir imagens (só em dev local —
# em produção o Cloud Run já usa sua própria service account automaticamente)
GOOGLE_APPLICATION_CREDENTIALS=".secrets/storage-sa-key.json"

# ID do projeto no Google Cloud (Firestore/Storage)
GOOGLE_CLOUD_PROJECT="beerlanda"

# Só necessário em plataformas SEM metadata server do GCP (ex: Vercel, Render).
# Cole aqui o JSON INTEIRO da mesma service account key (uma linha só) —
# no Cloud Run isso não é usado, pois as credenciais já vêm do ambiente.
FIREBASE_SERVICE_ACCOUNT_KEY=""

# --- MERCADO PAGO (checkout com cartão e Pix) ---
# Public Key: usada no FRONTEND (não é segredo, identifica a conta)
MERCADOPAGO_PUBLIC_KEY="MY_MERCADOPAGO_PUBLIC_KEY"

# Access Token: usada só no BACKEND — nunca expor no frontend nem commitar
MERCADOPAGO_ACCESS_TOKEN="MY_MERCADOPAGO_ACCESS_TOKEN"

# --- MELHOR ENVIO (cálculo de frete) ---
# Agregador e único cotador da loja: uma chamada devolve Correios, Jadlog, Azul e
# outras, com tarifa negociada e SEM exigir contrato próprio com transportadora.
# ATENÇÃO: o token vale 30 dias. Quando expira, a cotação volta 401 e o checkout
# cai no "frete a combinar" — o painel admin, em Integrações, mostra isso.
MELHOR_ENVIO_TOKEN=""

# "true" aponta para sandbox.melhorenvio.com.br (ambiente de teste, saldo
# fictício, só Correios e Jadlog). Vazio ou "false" usa produção.
MELHOR_ENVIO_SANDBOX=""

# CEP de origem dos envios, de onde o pacote sai. Sem ele não há cotação.
ORIGIN_CEP="MY_ORIGIN_CEP"

# --- RETIRADA EM MÃOS ---
# WhatsApp da loja, só dígitos com DDI (ex: 5541998765432). Vazio esconde o
# botão "Falar no WhatsApp"; a retirada segue funcionando pelo telefone do pedido.
WHATSAPP_NUMBER=""

# Cidade/região mostrada na opção de retirada
PICKUP_CITY="Curitiba e região"

# --- E-MAIL (SMTP do Gmail da loja) ---
# Senha de app de 16 letras, gerada em myaccount.google.com/apppasswords
# (exige verificação em duas etapas ativa na conta). NÃO é a senha do Gmail.
# Vazio = nenhum e-mail sai da loja; nada mais quebra por causa disso.
SMTP_PASS=""

# Opcionais — os padrões já apontam para o Gmail e para o CONTACT_EMAIL
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""

# Pausa entre mensagens de campanha (ms) e teto por disparo. O Gmail gratuito
# entrega ~500/dia e trata rajada como uso atípico.
EMAIL_BULK_DELAY_MS="1500"
EMAIL_BULK_DAILY_CAP="400"

# Segredo do gatilho de carrinho abandonado, chamado pelo Cloud Scheduler em
# POST /api/tasks/abandoned-cart com o cabeçalho x-tasks-secret.
TASKS_SECRET=""
